  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:data-validation": "cypress run --spec \"cypress/e2e/calculator/data-validation/**/*.cy.ts\"",
    "cypress:run:optimizer": "cypress run --spec \"cypress/e2e/calculator/optimizer/**/*.cy.ts\"",
    "cypress:run:team-rotations": "cypress run --spec \"cypress/e2e/teamRotations/**/*.cy.ts\"",
    "cypress:run:calculator-core": "cypress run --spec \"cypress/e2e/calculator/*.cy.ts\"",
    "test:e2e": "vite dev & wait-on http://localhost:5173 && cypress run",
    "cli": "tsx cli/index.ts"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "html-to-image": "^1.11.13",
